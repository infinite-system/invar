node_modules/
artifacts/status.json
artifacts/.status.json.tmp
artifacts/tui.log
artifacts/terminal-captures/
artifacts/process-snapshots/
*.log

# codex worker worktrees (own branches, not embedded in main tree)
.claude/worktrees/
# Harness output is GENERATED, so ignore the CLASS, not each instance. Three
# generated artifacts have reached the index by naming instances here and then
# meeting a `git add -A`: a fold-dense sibling slipped past
# `artifacts/*scroll-smoothness.json` and later blocked an ff-merge, and
# `artifacts/render-progress.json` appeared the same way. An exception list that
# keeps growing is evidence the rule is at the wrong level.
#
# Everything the harness writes directly into artifacts/ is ignored. The one
# tracked JSON is re-admitted below; .gitkeep files in subdirectories are
# unaffected because these patterns do not descend.
artifacts/*.json
artifacts/*.log
artifacts/*.tmp
artifacts/*.pulse
!artifacts/frame.json
artifacts/home/
dist/
.perf-history/

# Scratch + generated scale fixtures (see AGENTS.md SCALE PARITY, task #136).
# Large fixtures are GENERATED here and cached, never committed — a 100k-line
# file in git lives in every clone forever and churns on every regeneration.
tmp/

# macOS AppleDouble metadata from the Parallels shared mount
._*
.DS_Store
