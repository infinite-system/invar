#!/usr/bin/env bash
# Pre-commit gate: the FULL merge-gate must pass before a primary-checkout commit lands. This exists
# because the smoke suite went red for ~5 commits (the Ctrl+P→palette rebind) while every commit
# claimed "gated/green" — conventions-gate / FAST=1 skip the multi-launch smokes, so "MEASURED !=
# ENFORCED" recurred. Dispatched builder worktrees carry the narrow policy marker checked below.
#
# Bypass (use sparingly, e.g. a docs-only WIP checkpoint): SKIP_GATE=1 git commit ...
# Install: bash scripts/install-hooks.sh  (symlinks .git/hooks/pre-commit → this file).
set -uo pipefail

# FORMAT FIRST, always (even under SKIP_GATE): staged TypeScript is prettier-formatted and
# re-staged, so every commit lands uniform (80-char width, 2-space indent) regardless of which
# builder or human wrote it. Scope matches .prettierignore.
export PATH="$HOME/.bun/bin:$PATH"
staged_typescript_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' | grep -vE '^(dist/|node_modules/)' || true)"
if [ -n "$staged_typescript_files" ]; then
  echo "$staged_typescript_files" | xargs bunx prettier --write --log-level warn
  echo "$staged_typescript_files" | xargs git add
  echo "pre-commit: prettier formatted $(echo "$staged_typescript_files" | wc -l) staged file(s)." >&2
fi

# dispatch.sh plants this marker in the linked worktree's private Git directory.
# The primary checkout resolves the same name in the common Git directory, where
# dispatch never plants it. An exact value makes a damaged marker fail closed.
builder_hook_policy_path="$(git rev-parse --git-path invar-builder-hook-policy)"
builder_hook_policy=""
if [ -f "$builder_hook_policy_path" ]; then
  IFS= read -r builder_hook_policy < "$builder_hook_policy_path" || true
fi
if [ "$builder_hook_policy" = "skip-full-merge-gate-v1" ]; then
  echo "pre-commit: builder hook policy skips the full merge gate because the conductor gates the combined tree at landing." >&2
  exit 0
fi

if [ "${SKIP_GATE:-0}" = "1" ]; then
  echo "pre-commit: SKIP_GATE=1 — skipping the full merge-gate (bypass acknowledged)." >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
export PATH="$HOME/.bun/bin:$PATH"
# Skip the SOFT, slow perf-baselines on commit (informational; its load-bearing idle-quiescence
# invariant is HARD-gated in behavioral-contracts, which this run includes). Full `merge-gate.sh`
# (manual/CI) still measures perf. Set SKIP_PERF=0 to include it here too.
export SKIP_PERF="${SKIP_PERF:-1}"
echo "pre-commit: running the merge-gate (hard gates; perf soft-skipped; SKIP_GATE=1 to bypass)…" >&2
if bash "$REPO_ROOT/scripts/merge-gate.sh"; then
  echo "pre-commit: merge-gate GREEN — commit allowed." >&2
  exit 0
fi
echo "pre-commit: merge-gate RED — commit BLOCKED. Fix the gate or SKIP_GATE=1 to override." >&2
exit 1
